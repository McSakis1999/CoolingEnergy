---
import { businessInfo } from '../data/businessInfo.js';
import SharePage from './SharePage.astro';
import { withBase, serviceUrl } from '../utils/urls.js';
const services = [['episkevi-klimatistikon','Κλιματιστικά'],['episkevi-psygeion','Ψυγεία'],['episkevi-plyntirion','Πλυντήρια ρούχων'],['episkevi-ilektrikon-kouzinon','Κουζίνες & φούρνοι']];
const pages = [['giorgos-moutos/','Γιώργος Μούτος'],['omada/','Η ομάδα'],['erga/','Από τη δουλειά μας'],['faq/','Συχνές ερωτήσεις'],['perioxes/','Περιοχές εξυπηρέτησης']];
const socials = (businessInfo.socialLinks || []).filter(link => /^https:\/\//i.test(link.url));
---
<footer class="site-footer">
<div class="container">
  <div class="footer-intro"><div><p class="eyebrow">COOLINGENERGY · ΒΟΛΟΣ & ΠΗΛΙΟ</p><h2>Φροντίδα για το σπίτι σας.<br /><span>Ξεκινά με μια επικοινωνία.</span></h2></div><a class="button" href={businessInfo.phone ? 'tel:'+businessInfo.phone : withBase('#contact')}>{businessInfo.phone ? 'Καλέστε μας' : 'Στοιχεία επικοινωνίας'} <span aria-hidden="true">↗</span></a></div>
  <div class="footer-columns">
    <div class="footer-identity"><a class="footer-brand" href={withBase()}>Cooling<span>Energy</span></a><p class="footer-owner">{businessInfo.ownerName}</p><p>Κλιματιστικά, ψυγεία, πλυντήρια και ηλεκτρικές κουζίνες. Τεχνική φροντίδα στον Βόλο και τα χωριά του Πηλίου.</p><div class="footer-social"><h3>Βρείτε μας online</h3>{socials.length ? <ul class="social-links">{socials.map(link=><li><a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.label+' (ανοίγει σε νέα καρτέλα)'}>{link.label} <span aria-hidden="true">↗</span></a></li>)}</ul> : <><ul class="social-links social-samples"><li><span>Instagram ↗</span></li><li><span>Facebook ↗</span></li></ul><p class="sample-note">Ενδεικτικά προφίλ · οι σύνδεσμοι θα προστεθούν.</p></>}</div></div>
    <nav aria-label="Υπηρεσίες στο υποσέλιδο"><h3>Υπηρεσίες</h3><ul>{services.map(([slug,label])=><li><a href={serviceUrl(slug)}>{label}</a></li>)}<li><a class="footer-all" href={withBase('#services')}>Όλες οι υπηρεσίες <span aria-hidden="true">→</span></a></li></ul></nav>
    <nav aria-label="Χρήσιμοι σύνδεσμοι"><h3>Η CoolingEnergy</h3><ul>{pages.map(([path,label])=><li><a href={withBase(path)}>{label}</a></li>)}</ul></nav>
    <div class="footer-contact"><h3>Επικοινωνία</h3><address>{businessInfo.phone && <a href={'tel:'+businessInfo.phone}><span class="contact-label">Τηλέφωνο</span>{businessInfo.phoneFormatted || businessInfo.phone}</a>}{businessInfo.email && <a href={'mailto:'+businessInfo.email}><span class="contact-label">Email</span>{businessInfo.email}</a>}{businessInfo.address && <p><span class="contact-label">Διεύθυνση</span>{businessInfo.address}</p>}{businessInfo.viberUrl && <a href={businessInfo.viberUrl}>Επικοινωνία στο Viber ↗</a>}</address>{!businessInfo.phone && !businessInfo.email && <div class="sample-contact"><p class="sample-note">Ενδεικτικά στοιχεία επικοινωνίας</p><p><span class="contact-label">Τηλέφωνο</span>+30 69X XXX XXXX</p><p><span class="contact-label">Email</span>info@example.com</p></div>}<p><span class="contact-label">{businessInfo.workingHours ? "Ωράριο" : "Ενδεικτικό ωράριο"}</span>{businessInfo.workingHours || "Δευτέρα–Παρασκευή · 09:00–17:00"}</p><div class="footer-coverage"><span class="contact-label">Περιοχές επίσκεψης</span><a href={withBase('perioxes/')}>Βόλος & Πήλιο ↗</a><p>Η επίσκεψη και η κάλυψη της περιοχής σας επιβεβαιώνονται κατόπιν συνεννόησης.</p></div></div>
  </div>
  <SharePage />
  <div class="footer-privacy"><a href={withBase('privacy/')}>Απόρρητο & cookies</a><button type="button" data-cookie-settings hidden>Ρυθμίσεις cookies</button></div>
  <div class="footer-bottom"><p>© {new Date().getFullYear()} {businessInfo.name}. Με επιφύλαξη παντός δικαιώματος.</p><a href="#main">Επιστροφή στην κορυφή <span aria-hidden="true">↑</span></a></div>
</div>
</footer>
<nav class="mobile-bar" aria-label="Γρήγορη πρόσβαση"><a href={withBase('#services')}>Υπηρεσίες</a><a href={businessInfo.phone ? 'tel:'+businessInfo.phone : withBase('#contact')}>{businessInfo.phone ? 'Τηλέφωνο' : 'Επικοινωνία'}</a></nav>
<style>
.footer-privacy{display:flex;flex-wrap:wrap;gap:24px;padding-bottom:24px;color:#bbccdf;font-size:14px}.footer-privacy a,.footer-privacy button{text-decoration:underline}.footer-privacy button{background:none;border:0;padding:0;color:inherit;cursor:pointer}.footer-privacy button[hidden]{display:none}
.site-footer{padding:0;background:#0b2035}.footer-intro{display:flex;justify-content:space-between;gap:40px;align-items:center;padding:52px 0;border-bottom:1px solid #304459}.footer-intro .eyebrow{color:#91c3ff;font-size:12px;margin:0 0 18px}.footer-intro h2{color:#fff;font-size:clamp(27px,3vw,38px);margin:0;line-height:1.25}.footer-intro h2 span{color:#9fb8d1}.footer-intro .button{flex-shrink:0}.footer-columns{display:grid;grid-template-columns:1.4fr .85fr 1fr 1.2fr;gap:36px;padding:46px 0}.footer-columns h3{font-size:16px;color:#fff;letter-spacing:0;margin-bottom:20px}.footer-columns p{font-size:14px;line-height:1.75;margin:0 0 18px;color:#bbccdf}.footer-columns .footer-owner{margin:12px 0 16px;color:#e7eef6}.footer-columns ul{list-style:none;margin:0;padding:0;display:grid;gap:14px}.footer-columns a{font-size:14px;line-height:1.6}.footer-columns .footer-brand{font-size:27px}.footer-columns a:hover,.footer-bottom a:hover{color:#8ec2ff}.footer-all{color:#8ec2ff}.footer-social{margin-top:26px}.footer-social h3{margin-bottom:12px}.footer-columns .social-links{display:flex;flex-wrap:wrap;gap:8px}.social-links a,.social-samples span{display:inline-flex;gap:14px;border:1px solid #3e5770;border-radius:6px;padding:8px 12px}.footer-columns .footer-pending{color:#9fb3c9;font-size:14px}.social-samples span{font-size:14px;color:#9fb3c9}.footer-columns .sample-note{font-size:12px;color:#8fa9c4;margin-top:10px}.footer-contact address{font-style:normal}.footer-contact address>a{display:block;margin-bottom:18px;overflow-wrap:anywhere}.contact-label{display:block;color:#8fa9c4;font-size:12px;font-weight:600;margin-bottom:5px}.footer-coverage{margin-top:24px}.footer-coverage p{margin-top:10px}.footer-bottom{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:24px 0;border-top:1px solid #304459}.footer-bottom p,.footer-bottom a{font-size:12px;margin:0}.footer-bottom a{white-space:nowrap}@media(max-width:1050px){.footer-columns{grid-template-columns:1fr 1fr;gap:36px 50px}}@media(max-width:760px){.site-footer{padding-bottom:90px}.footer-intro{flex-direction:column;align-items:start;padding:36px 0;gap:24px}.footer-columns{gap:34px 24px;padding:34px 0}.footer-identity,.footer-contact{grid-column:1/-1}.footer-columns h3{margin-bottom:16px}.footer-bottom{flex-direction:column;align-items:start;gap:16px}.footer-bottom p{line-height:1.6}}
</style>

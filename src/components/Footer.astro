---
import { businessInfo } from '../data/businessInfo.js';

import { withBase, serviceUrl } from '../utils/urls.js';
const services = [['episkevi-klimatistikon','Κλιματιστικά'],['episkevi-psygeion','Ψυγεία'],['episkevi-plyntirion','Πλυντήρια ρούχων'],['episkevi-ilektrikon-kouzinon','Κουζίνες & φούρνοι']];
const pages = [['giorgos-moutos/','Γιώργος Μούτος'],['omada/','Η ομάδα'],['erga/','Από τη δουλειά μας'],['faq/','Συχνές ερωτήσεις'],['perioxes/','Περιοχές εξυπηρέτησης']];
const socials = (businessInfo.socialLinks || []).filter(link => /^https:\/\//i.test(link.url));
---
<footer class="site-footer">
<div class="container">
  <div class="footer-intro"><div><p class="eyebrow">COOLINGENERGY · ΒΟΛΟΣ & ΠΗΛΙΟ</p><h2>Φροντίδα για το σπίτι σας.<br /><span>Ξεκινά με μια επικοινωνία.</span></h2></div><a class="button" href={businessInfo.phone ? 'tel:'+businessInfo.phone : withBase('#contact')}>{businessInfo.phone ? 'Καλέστε μας' : 'Στοιχεία επικοινωνίας'} <span aria-hidden="true">↗</span></a></div>
  <div class="footer-columns">
    <div class="footer-identity"><a class="footer-brand" href={withBase()}><span>Cooling</span>Energy</a><p class="footer-owner">{businessInfo.ownerName}<br />ΑΦΜ: {businessInfo.taxId}</p><p>Κλιματιστικά, ψυγεία, πλυντήρια και ηλεκτρικές κουζίνες. Τεχνική φροντίδα στον Βόλο και τα χωριά του Πηλίου.</p><div class="footer-social"><h3>Βρείτε μας online</h3><ul class="social-links">
  {socials.map(link => <li><a class="social-button instagram" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.label+' (ανοίγει σε νέα καρτέλα)'} title={link.label}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg></a></li>)}
  {businessInfo.viberUrl && <li><a class="social-button viber" href={businessInfo.viberUrl} aria-label="Επικοινωνία στο Viber" title="Viber"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19.8 3.8C16.2 1.4 7.8 1.4 4.2 3.8 1.5 5.6 1.5 15.2 4.2 17.5l2.3 1V22l3.8-3.4c3.6.3 7.2-.2 9.5-1.7 2.7-2 2.7-11.1 0-13.1Z" /><path fill="currentColor" stroke="none" d="M8.1 6.4c-.5-.5-1.1-.3-1.5.1l-.8.9c-.5.7.1 2.7 1.7 4.8s3.8 3.8 5.6 4.4c.9.3 1.5.2 1.9-.3l.9-1.2c.3-.4.3-.8-.2-1.2l-1.9-1.3c-.4-.3-.8-.2-1.1.2l-.6.7c-.3.3-.6.2-1-.1-1.2-.7-2.1-1.7-2.7-2.8-.2-.4-.3-.7 0-1l.6-.6c.3-.3.4-.7.1-1.1Z" /><path d="M12 5.5a6.5 6.5 0 0 1 6.5 6.5M12.4 8a3.7 3.7 0 0 1 3.7 3.7" /></svg></a></li>}
</ul></div></div>
    <nav aria-label="Υπηρεσίες στο υποσέλιδο"><h3>Υπηρεσίες</h3><ul>{services.map(([slug,label])=><li><a href={serviceUrl(slug)}>{label}</a></li>)}<li><a class="footer-all" href={withBase('#services')}>Όλες οι υπηρεσίες <span aria-hidden="true">→</span></a></li></ul></nav>
    <nav aria-label="Χρήσιμοι σύνδεσμοι"><h3>Η CoolingEnergy</h3><ul>{pages.map(([path,label])=><li><a href={withBase(path)}>{label}</a></li>)}</ul></nav>
    <div class="footer-contact"><h3>Επικοινωνία</h3><address>{businessInfo.phone && <a href={'tel:'+businessInfo.phone}><span class="contact-label">Τηλέφωνο</span>{businessInfo.phoneFormatted || businessInfo.phone}</a>}{businessInfo.email && <a href={'mailto:'+businessInfo.email}><span class="contact-label">Email</span>{businessInfo.email}</a>}{businessInfo.address && <p><span class="contact-label">Διεύθυνση</span>{businessInfo.address}</p>}</address>{businessInfo.workingHours && <p><span class="contact-label">Ωράριο</span>{businessInfo.workingHours}</p>}<div class="footer-coverage"><span class="contact-label">Περιοχές επίσκεψης</span><a href={withBase('perioxes/')}>Βόλος & Πήλιο ↗</a><p>Η επίσκεψη και η κάλυψη της περιοχής σας επιβεβαιώνονται κατόπιν συνεννόησης.</p></div></div>
  </div>

  <div class="footer-privacy"><a href={withBase('privacy/')}>Απόρρητο & cookies</a><button type="button" data-cookie-settings hidden>Ρυθμίσεις cookies</button></div>
  <div class="footer-bottom"><p>© {new Date().getFullYear()} {businessInfo.name}. Με επιφύλαξη παντός δικαιώματος.</p><a href="#main">Επιστροφή στην κορυφή <span aria-hidden="true">↑</span></a></div>
</div>
</footer>
<nav class="mobile-bar" aria-label="Γρήγορη πρόσβαση"><a href={withBase('#services')}>Υπηρεσίες</a><a href={businessInfo.phone ? 'tel:'+businessInfo.phone : withBase('#contact')}>{businessInfo.phone ? 'Τηλέφωνο' : 'Επικοινωνία'}</a></nav>
<style>
.footer-privacy{display:flex;flex-wrap:wrap;gap:24px;padding-bottom:24px;color:#bbccdf;font-size:14px}.footer-privacy a,.footer-privacy button{text-decoration:underline}.footer-privacy button{background:none;border:0;padding:0;color:inherit;cursor:pointer}.footer-privacy button[hidden]{display:none}
.site-footer{padding:0;background:#0b2035}.footer-intro{display:flex;justify-content:space-between;gap:40px;align-items:center;padding:52px 0;border-bottom:1px solid #304459}.footer-intro .eyebrow{color:#91c3ff;font-size:12px;margin:0 0 18px}.footer-intro h2{color:#fff;font-size:clamp(27px,3vw,38px);margin:0;line-height:1.25}.footer-intro h2 span{color:#9fb8d1}.footer-intro .button{flex-shrink:0}.footer-columns{display:grid;grid-template-columns:1.4fr .85fr 1fr 1.2fr;gap:36px;padding:46px 0}.footer-columns h3{font-size:16px;color:#fff;letter-spacing:0;margin-bottom:20px}.footer-columns p{font-size:14px;line-height:1.75;margin:0 0 18px;color:#bbccdf}.footer-columns .footer-owner{margin:12px 0 16px;color:#e7eef6}.footer-columns ul{list-style:none;margin:0;padding:0;display:grid;gap:14px}.footer-columns a{font-size:14px;line-height:1.6}.footer-columns .footer-brand,.footer-columns .footer-brand:hover{font-size:27px;color:#fff}.footer-columns a:hover,.footer-bottom a:hover{color:#8ec2ff}.footer-all{color:#8ec2ff}.footer-social{margin-top:26px}.footer-social h3{margin-bottom:12px}.footer-columns .social-links{display:flex;flex-wrap:wrap;gap:8px}.footer-contact address{font-style:normal}.footer-contact address>a{display:block;margin-bottom:18px;overflow-wrap:anywhere}.contact-label{display:block;color:#8fa9c4;font-size:12px;font-weight:600;margin-bottom:5px}.footer-coverage{margin-top:24px}.footer-coverage p{margin-top:10px}.footer-bottom{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:24px 0;border-top:1px solid #304459}.footer-bottom p,.footer-bottom a{font-size:12px;margin:0}.footer-bottom a{white-space:nowrap}@media(max-width:1050px){.footer-columns{grid-template-columns:1fr 1fr;gap:36px 50px}}@media(max-width:760px){.site-footer{padding-bottom:90px}.footer-intro{flex-direction:column;align-items:start;padding:36px 0;gap:24px}.footer-columns{gap:34px 24px;padding:34px 0}.footer-identity,.footer-contact{grid-column:1/-1}.footer-columns h3{margin-bottom:16px}.footer-bottom{flex-direction:column;align-items:start;gap:16px}.footer-bottom p{line-height:1.6}}
.footer-columns .social-button{display:inline-flex;align-items:center;justify-content:center;width:48px;height:48px;padding:0;border:0;border-radius:50%;color:#fff;transition:transform .2s,filter .2s}.social-button svg{width:26px;height:26px}.social-button.instagram{background:radial-gradient(circle at 30% 100%,#feda75 0%,#fa7e1e 25%,#d62976 50%,#962fbf 75%,#4f5bd5 100%)}.social-button.viber{background:#7360f2}.footer-columns .social-button:hover{color:#fff;transform:translateY(-2px);filter:brightness(1.1)}.social-button:focus-visible{outline:3px solid #fff;outline-offset:4px}@media(prefers-reduced-motion:reduce){.footer-columns .social-button{transition:none}.footer-columns .social-button:hover{transform:none}}
</style>

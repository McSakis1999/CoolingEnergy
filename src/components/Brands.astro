---
import { withBase } from '../utils/urls.js';
const brands = [['Daikin','daikin-logo-1-.svg'],['Mitsubishi Electric','mitsubishi.svg'],['Fujitsu','fujitsu-logo.svg'],['Inventor','inventor.png'],['Carrier','carrier-heat-ac-1.svg'],['Midea','midea-1.svg'],['LG','lg-electronics.svg'],['Toshiba','toshiba-3.svg'],['Bosch','bosch-logo-simple.svg']];
---
<section class="brands-section" aria-labelledby="brands-title"><div class="container brands-heading"><div><p class="eyebrow">ΟΙΚΙΑΚΕΣ ΣΥΣΚΕΥΕΣ & ΚΛΙΜΑΤΙΣΜΟΣ</p><h2 id="brands-title">Η δική σας μάρκα.</h2><p>Ρωτήστε μας για το μοντέλο σας. Τα λογότυπα δεν δηλώνουν εξουσιοδότηση ή επίσημη συνεργασία.</p></div></div><div class="brand-window"><div id="brand-track" class="brand-track">{[0,1].map(copy=><div class="brand-set" aria-hidden={copy===1?'true':undefined}>{brands.map(([name,file])=><div class="brand-tile"><img src={withBase('images/brands/'+file)} alt={copy===0?name:''} width="130" height="42" loading="eager" decoding="async" /></div>)}</div>)}</div></div></section>
<style>
.brands-section{padding:38px 0;background:#f8fafc;border-bottom:1px solid #e1e8ef;overflow:hidden}.brands-heading{display:flex;justify-content:space-between;align-items:center;gap:24px}.brands-heading h2{font-size:25px;margin-bottom:10px}.brands-heading p{font-size:14px;max-width:680px}.brands-heading .eyebrow{margin-bottom:10px}.brand-window{overflow:hidden;max-width:1600px;margin:18px auto 0}.brand-track{display:flex;width:max-content;animation:brands-scroll 32s linear infinite}.brand-set{display:flex;flex:none;gap:20px;padding-right:20px}.brand-tile{flex:none;width:170px;height:80px;display:grid;place-items:center;background:white;border:1px solid #dee6ef;border-radius:10px}.brand-tile img{width:130px;height:42px;object-fit:contain}.brand-window:hover .brand-track{animation-play-state:paused}@keyframes brands-scroll{to{transform:translateX(-50%)}}@media(max-width:760px){.brands-heading{align-items:start;flex-direction:column}}@media(prefers-reduced-motion:reduce){.brand-track{animation:none}.brand-window{overflow-x:auto}.brand-set[aria-hidden="true"],}
</style>



---
import { areaGroups } from '../data/areas.js';
import { withBase } from '../utils/urls.js';
---
<section id="service-areas" class="coverage"><div class="container coverage-grid"><div><p class="eyebrow">ΚΟΝΤΑ ΣΤΟ ΣΠΙΤΙ ΣΑΣ</p><h2>Βόλος & τα χωριά του Πηλίου</h2><p>Ψυκτικός και τεχνικός για κλιματιστικά, ψυγεία, πλυντήρια και ηλεκτρικές κουζίνες. Αναφέρετε τον οικισμό και την ακριβή διεύθυνσή σας. Η δυνατότητα επίσκεψης, η διαθεσιμότητα και τυχόν κόστος μετακίνησης επιβεβαιώνονται πριν από το ραντεβού.</p><a class="button" href={withBase('perioxes/')}>Δείτε όλες τις περιοχές →</a></div><div class="coverage-places">{areaGroups.map(group=><details><summary>{group.title}</summary><ul class="place-list">{group.places.map(place=><li>{place}</li>)}</ul></details>)}</div></div></section>

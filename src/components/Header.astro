---
import { businessInfo } from '../data/businessInfo.js';
import { withBase } from '../utils/urls.js';
const links = [['services','Υπηρεσίες'],['service-areas','Περιοχές'],['gallery','Φωτογραφίες'],['faq','FAQ'],['contact','Επικοινωνία']];
---
<header class="site-header">
<div class="container header-inner">
<a class="brand" href={withBase()} aria-label="CoolingEnergy — Αρχική"><img src={withBase('images/logo.png')} alt="" width="54" height="54" /><span><span class="brand-blue">Cooling</span>Energy<small>{businessInfo.ownerName}</small></span></a>
<nav class="desktop-nav" aria-label="Κύρια πλοήγηση">{links.map(([id,label]) => <a href={withBase('#'+id)}>{label}</a>)}</nav>
<a class="button small header-action" href={'tel:'+businessInfo.phone}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.79a2 2 0 0 1-.45 2.11L8.09 9.89a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.89.33 1.83.56 2.79.69A2 2 0 0 1 22 16.92z" /></svg>Επικοινώνησε μαζί μας</a>
<details class="mobile-menu"><summary>Μενού</summary><nav aria-label="Πλοήγηση κινητού">{links.map(([id,label]) => <a href={withBase('#'+id)}>{label}</a>)}</nav></details>
</div>
</header>
<script>
document.querySelectorAll('.mobile-menu a').forEach(link => link.addEventListener('click', () => { document.querySelector('.mobile-menu')?.removeAttribute('open'); }));
</script>

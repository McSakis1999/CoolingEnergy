---
import { businessInfo } from '../data/businessInfo.js';
import { withBase } from '../utils/urls.js';
const links = [['services','Υπηρεσίες'],['service-areas','Περιοχές'],['gallery','Φωτογραφίες'],['faq','FAQ'],['contact','Επικοινωνία']];
const phoneIcon = "M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.79a2 2 0 0 1-.45 2.11L8.09 9.89a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.89.33 1.83.56 2.79.69A2 2 0 0 1 22 16.92z";
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase()} aria-label="CoolingEnergy — Αρχική">
      <img src={withBase('images/logo.png')} alt="" width="54" height="54" />
      <span><span class="brand-blue">Cooling</span>Energy<small>{businessInfo.ownerName}</small></span>
    </a>

    <nav class="desktop-nav" aria-label="Κύρια πλοήγηση">
      {links.map(([id,label]) => <a href={withBase('#'+id)}>{label}</a>)}
    </nav>

    <a class="button small header-action" href={'tel:'+businessInfo.phone}>
      <span class="cta-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phoneIcon} /></svg>
      </span>
      <span class="cta-text">Επικοινώνησε μαζί μας</span>
      <span class="cta-shine" aria-hidden="true"></span>
    </a>

    <div class="mobile-actions">
      <a class="mobile-call" href={'tel:'+businessInfo.phone} aria-label="Κλήση">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phoneIcon} /></svg>
      </a>

      <details class="mobile-menu">
        <summary aria-label="Μενού">
          <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
        </summary>
        <nav aria-label="Πλοήγηση κινητού">
          {links.map(([id,label]) => <a href={withBase('#'+id)}>{label}</a>)}
          <a class="mobile-cta" href={'tel:'+businessInfo.phone}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phoneIcon} /></svg>
            Επικοινώνησε μαζί μας
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const menu = document.querySelector('.mobile-menu');
  menu?.querySelectorAll('a').forEach(link =>
    link.addEventListener('click', () => menu.removeAttribute('open'))
  );
  document.addEventListener('click', (e) => {
    if (menu?.hasAttribute('open') && !menu.contains(e.target as Node)) menu.removeAttribute('open');
  });
</script>

<style>
  .site-header {
    --hd-blue: var(--blue, #0ea5e9);
    --hd-link: #77b7ff;
    --hd-muted: #b6c7d8;
    --hd-line: #28435d;

    position: sticky;
    top: 0;
    background: var(--navy);
    color: #fff;
    border-bottom: 1px solid var(--hd-line);
    z-index: 50;
    transition: box-shadow 0.3s ease;
  }

  .site-header::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--hd-link), transparent);
    opacity: 0.45;
    pointer-events: none;
  }

  .site-header.is-scrolled {
    box-shadow: 0 5px 9px rgba(0, 0, 0, 0.35);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 90px;
  }

  /* ---------- Brand ---------- */
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 24px; .desktop-nav a
    font-weight: 800;
    letter-spacing: -1px;
    color: #fff;
    text-decoration: none; 
    flex: none;
  }

  .brand img {
    object-fit: contain;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .brand:hover img {
    transform: rotate(-6deg) scale(1.06);
  }

  .brand small {
    display: block;
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--hd-muted);
    margin-top: 5px;
  }

  .brand-blue {
    color: var(--hd-link);
  }

  /* ---------- Desktop nav ---------- */
  .desktop-nav {
    display: none;
    gap: 25px;
    font-size: 13px;
    font-weight: 600;
  }

  .desktop-nav a {
    position: relative;
    padding: 0.5rem 0;
    color: #fff;
    text-decoration: none;
    transition: color 0.25s ease, transform 0.25s ease;
    white-space: nowrap;
  }

  .desktop-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--hd-link), #22d3ee);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a:focus-visible {
    color: var(--hd-link);
    transform: translateY(-2px);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* ---------- CTA button ---------- */
  .header-action {
    position: relative;
    display: none;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.2rem 0.5rem 0.5rem;
    border-radius: 999px;
    border: 0;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    color: #fff;
    background: linear-gradient(135deg, var(--hd-blue), color-mix(in srgb, var(--hd-blue) 65%, #1e3a8a));
    box-shadow:
      0 10px 24px color-mix(in srgb, var(--hd-blue) 40%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
    transition: transform 0.25s ease, box-shadow 0.25s ease; 
    flex: none;
  }

  .header-action:hover {
    transform: translateY(-2px);
    box-shadow:
      0 16px 32px color-mix(in srgb, var(--hd-blue) 55%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  .header-action:active {
    transform: translateY(0) scale(0.98);
  }

  .cta-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }

  .cta-icon::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.55);
    animation: cta-pulse 2.4s ease-out infinite;
  }

  .cta-icon svg {
    animation: ring 4s ease-in-out infinite;
  }

  .cta-shine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -60%;
    width: 40%;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.35), transparent);
    transform: skewX(-20deg);
    pointer-events: none;
  }

  .header-action:hover .cta-shine {
    animation: shine 0.9s ease;
  }

  /* ---------- Mobile ---------- */
  .mobile-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: none;
  }

   .mobile-menu {
    display: block;
    position: static; /* keeps the dropdown anchored to the sticky header */
    flex: none;
    border-bottom: none;
  }

 .mobile-call,
  .mobile-menu summary {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    line-height: 0;
    border-radius: 14px;
    cursor: pointer;
    list-style: none;
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--hd-line);
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
  }

  .mobile-call {
    background: linear-gradient(135deg, var(--hd-blue), color-mix(in srgb, var(--hd-blue) 65%, #1e3a8a));
    border-color: transparent;
    box-shadow: 0 8px 18px color-mix(in srgb, var(--hd-blue) 40%, transparent);
  }

  .mobile-call svg {
    animation: ring 4s ease-in-out infinite;
  }

  .mobile-call:active,
  .mobile-menu summary:active {
    transform: scale(0.94);
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu[open] summary {
    background: color-mix(in srgb, var(--hd-link) 18%, transparent);
    border-color: color-mix(in srgb, var(--hd-link) 50%, transparent);
  }

  /* Burger -> X */
  .burger {
    position: relative;
    display: block;
    flex: none;
    margin: 0;
    width: 20px;
    height: 14px;
  }

  .burger i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.3s ease, opacity 0.2s ease, top 0.3s ease;
  }

  .burger i:nth-child(1) { top: 0; }
  .burger i:nth-child(2) { top: 6px; }
  .burger i:nth-child(3) { top: 12px; }

  .mobile-menu[open] .burger i:nth-child(1) { top: 6px; transform: rotate(45deg); }
  .mobile-menu[open] .burger i:nth-child(2) { opacity: 0; }
  .mobile-menu[open] .burger i:nth-child(3) { top: 6px; transform: rotate(-45deg); }

  /* Full-width dropdown panel (positions against the sticky header) */
  .mobile-menu nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: grid;
    gap: 0.35rem;
    padding: 1rem clamp(1rem, 4vw, 1.5rem) 1.5rem;
    background: var(--navy);
    border-bottom: 1px solid var(--hd-line);
    box-shadow: 0 24px 40px rgba(0, 0, 0, 0.45);
    animation: panel-in 0.3s ease;
  }

  .mobile-menu nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.95rem 1rem;
    border-radius: 14px;
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    color: #fff;
    opacity: 0;
    animation: item-in 0.4s ease forwards;
    transition: background 0.2s ease, color 0.2s ease, padding-left 0.25s ease;
  }

  .mobile-menu nav a:not(.mobile-cta)::after {
    content: "→";
    color: var(--hd-link);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .mobile-menu nav a:not(.mobile-cta):hover,
  .mobile-menu nav a:not(.mobile-cta):active {
    background: rgba(255, 255, 255, 0.06);
    color: var(--hd-link);
    padding-left: 1.3rem;
  }

  .mobile-menu nav a:not(.mobile-cta):hover::after,
  .mobile-menu nav a:not(.mobile-cta):active::after {
    opacity: 1;
    transform: translateX(0);
  }

  .mobile-menu nav a:nth-child(1) { animation-delay: 0.05s; }
  .mobile-menu nav a:nth-child(2) { animation-delay: 0.1s; }
  .mobile-menu nav a:nth-child(3) { animation-delay: 0.15s; }
  .mobile-menu nav a:nth-child(4) { animation-delay: 0.2s; }
  .mobile-menu nav a:nth-child(5) { animation-delay: 0.25s; }
  .mobile-menu nav a:nth-child(6) { animation-delay: 0.3s; }

  .mobile-menu nav .mobile-cta {
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.6rem;
    color: #fff;
    font-weight: 700;
    background: linear-gradient(135deg, var(--hd-blue), color-mix(in srgb, var(--hd-blue) 65%, #1e3a8a));
    box-shadow: 0 12px 26px color-mix(in srgb, var(--hd-blue) 40%, transparent);
  }

  /* ---------- Breakpoint ---------- */
  @media (min-width: 1024px) {
    .desktop-nav { display: flex; }
    .header-action { display: inline-flex; }
    .mobile-actions { display: none; }
  }

   @media (min-width: 1024px) and (max-width: 1180px) {
    .header-inner { gap: 14px; }
    .desktop-nav { gap: 18px; }
  }

  /* ---------- Animations ---------- */
  @keyframes ring {
    0%, 88%, 100% { transform: rotate(0); }
    91% { transform: rotate(-14deg); }
    94% { transform: rotate(12deg); }
    97% { transform: rotate(-8deg); }
  }

  @keyframes cta-pulse {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(1.7); opacity: 0; }
  }

  @keyframes shine {
    to { left: 130%; }
  }

  @keyframes panel-in {
    from { opacity: 0; transform: translateY(-8px); }
  }

  @keyframes item-in {
    from { opacity: 0; transform: translateX(-10px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-icon::before,
    .cta-icon svg,
    .mobile-call svg,
    .mobile-menu nav { animation: none; }
    .mobile-menu nav a { animation: none; opacity: 1; }
    .header-action:hover .cta-shine { animation: none; }
  }
</style>
---
const steps = [
  { title: 'Μας λέτε τι συμβαίνει.', text: 'Περιγράψτε τη συσκευή, το πρόβλημα και την περιοχή σας. Αυτά αρκούν για να ξεκινήσουμε.', note: 'Χρήσιμο: μάρκα & μοντέλο', icon: 'M7 9h10M7 13h6M5 3h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H9l-6 3V5a2 2 0 0 1 2-2Z', label: 'Η ΠΡΩΤΗ ΕΠΑΦΗ' },
  { title: 'Οργανώνουμε την επίσκεψη.', text: 'Συζητάμε τη διαθεσιμότητα, επιβεβαιώνουμε την περιοχή και σας ενημερώνουμε για τους όρους χρέωσης.', note: 'Πριν κλείσει το ραντεβού', icon: 'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2ZM8 15l3 3 5-5', label: 'ΤΟ ΡΑΝΤΕΒΟΥ' },
  { title: 'Ελέγχουμε τη συσκευή.', text: 'Με βάση τον έλεγχο, εξηγούμε την προτεινόμενη εργασία και αν χρειάζονται ανταλλακτικά.', note: 'Ξεκάθαρα επόμενα βήματα', icon: 'm9 12 2 2 4-4M12 3l8 4v5c0 5-8 9-8 9s-8-4-8-9V7l8-4Z', label: 'Ο ΤΕΧΝΙΚΟΣ ΕΛΕΓΧΟΣ' },
];
---
<section id="diadikasia" class="process-section" aria-labelledby="process-title">
  <div class="container section">
    <div class="process-heading" data-reveal>
      <div><p class="eyebrow">Η ΔΙΑΔΙΚΑΣΙΑ</p><h2 id="process-title">Εσείς μας λέτε την ανάγκη.<br /><span>Μαζί βρίσκουμε το επόμενο βήμα.</span></h2></div>
      <p class="process-intro">Τρία απλά βήματα, για να ξέρετε τι να περιμένετε από την πρώτη επικοινωνία μέχρι τον έλεγχο.</p>
    </div>
    <ol class="process-steps" role="list">
      {steps.map((step, index) => <li class="process-card" data-reveal style={`--reveal-delay: ${index * 85}ms`}>
        <div class="process-marker"><span class="process-number"><span class="sr-only">Βήμα </span>0{index + 1}</span><span class="process-connector" aria-hidden="true">→</span></div>
        <div class="process-card-body">
          <span class="process-bg-number" aria-hidden="true">0{index + 1}</span>
          <div class="process-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={step.icon} /></svg></div>
          <p class="process-label">{step.label}</p><h3>{step.title}</h3><p class="process-description">{step.text}</p>
          <p class="process-note"><span aria-hidden="true">✓</span>{step.note}</p>
        </div>
      </li>)}
    </ol>
    <div class="process-ready" data-reveal><span class="ready-symbol" aria-hidden="true">i</span><p><strong>Για μια πιο εύκολη πρώτη επικοινωνία</strong><br />Έχετε πρόχειρα το μοντέλο της συσκευής και μια σύντομη περιγραφή του προβλήματος.</p></div>
  </div>
</section>

<style>
  .process-section {
    --pr-blue: var(--blue, #1460dc);
    --pr-blue-2: #22d3ee;
    --pr-ink: var(--text, #0f172a);
    --pr-muted: #416180;
    --pr-border: #d4e1ef;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 90% 0%, color-mix(in srgb, var(--pr-blue-2) 14%, transparent), transparent 45%),
      radial-gradient(circle at 0% 100%, color-mix(in srgb, var(--pr-blue) 10%, transparent), transparent 45%),
      linear-gradient(145deg, #f8fbff, #eaf2fc);
    border-block: 1px solid #dce7f4;
  }

  /* ---------- Heading ---------- */
  .process-heading {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 60px;
    align-items: end;
    margin-bottom: 46px;
  }

  .process-section .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--pr-blue);
  }

  .process-section .eyebrow::before {
    content: "";
    width: 32px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  .process-heading h2 {
    font-size: clamp(29px, 3vw, 40px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--pr-ink);
  }

  .process-heading h2 span {
    background: linear-gradient(90deg, var(--pr-blue), var(--pr-blue-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .process-intro {
    font-size: 15px;
    line-height: 1.7;
    margin: 0;
    max-width: 350px;
    color: #526075;
  }

  /* ---------- Steps ---------- */
  .process-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .process-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .process-marker {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 20px;
  }

  .process-number {
    position: relative;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    flex: none;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--pr-blue), color-mix(in srgb, var(--pr-blue) 65%, #1e3a8a));
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    box-shadow:
      0 0 0 6px color-mix(in srgb, var(--pr-blue) 14%, white),
      0 10px 22px color-mix(in srgb, var(--pr-blue) 35%, transparent);
    transition: transform 0.3s ease;
  }

  .process-card:hover .process-number {
    transform: scale(1.08);
  }

  .process-connector {
    display: flex;
    align-items: center;
    flex: 1;
    color: var(--pr-blue);
    font-size: 22px;
    line-height: 1;
  }

  .process-connector::before {
    content: "";
    height: 2px;
    flex: 1;
    border-radius: 2px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--pr-blue) 55%, transparent), color-mix(in srgb, var(--pr-blue) 10%, transparent));
  }

  .process-card:last-child .process-connector {
    visibility: hidden;
  }

  /* ---------- Card ---------- */
  .process-card-body {
    position: relative;
    overflow: hidden;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 30px 26px 0;
    border: 1px solid var(--pr-border);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(23, 60, 101, 0.06);
  }

  /* blue accent line along the top, grows in on hover */
  .process-card-body::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--pr-blue), var(--pr-blue-2));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }

  .process-card-body:hover::before {
    transform: scaleX(1);
  }

  .process-bg-number {
    position: absolute;
    top: 6px;
    right: 18px;
    font-size: 84px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: color-mix(in srgb, var(--pr-blue) 7%, transparent);
    pointer-events: none;
    user-select: none;
  }

  .process-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 26px;
    border-radius: 15px;
    color: var(--pr-blue);
    background: color-mix(in srgb, var(--pr-blue) 10%, white);
    border: 1px solid color-mix(in srgb, var(--pr-blue) 18%, transparent);
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }

  .process-icon svg {
    width: 26px;
    height: 26px;
  }

  .process-card-body:hover .process-icon {
    color: #fff;
    background: linear-gradient(135deg, var(--pr-blue), var(--pr-blue-2));
    transform: rotate(-6deg);
  }

  .process-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--pr-blue);
    margin-bottom: 12px;
  }

  .process-card h3 {
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    max-width: 250px;
    margin-bottom: 16px;
    color: var(--pr-ink);
  }

  .process-description {
    font-size: 15px;
    line-height: 1.75;
    margin-bottom: 26px;
    color: #526075;
  }

  .process-note {
    display: flex;
    gap: 10px;
    align-items: center;
    margin: auto 0 0;
    border-top: 1px solid #e3ebf4;
    padding: 17px 0;
    font-size: 12px;
    font-weight: 600;
    color: var(--pr-muted);
  }

  .process-note span {
    display: grid;
    place-items: center;
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 700;
    color: var(--pr-blue);
    background: color-mix(in srgb, var(--pr-blue) 12%, white);
  }

  /* ---------- Ready note ---------- */
  .process-ready {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 32px;
    padding: 16px 20px;
    max-width: 640px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid var(--pr-border);
    border-left: 4px solid var(--pr-blue);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .process-ready p {
    font-size: 13px;
    line-height: 1.6;
    margin: 0;
    color: #5b728b;
  }

  .process-ready strong {
    color: #294b6d;
    font-weight: 700;
  }

  .ready-symbol {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 50%;
    color: #fff;
    background: var(--pr-blue);
    font-family: Georgia, serif;
    font-style: italic;
    font-weight: 700;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1000px) {
    .process-heading { gap: 30px; grid-template-columns: 1.4fr 1fr; }
    .process-steps { gap: 16px; }
    .process-card-body { padding: 24px 20px 0; }
    .process-card h3 { font-size: 21px; }
    .process-bg-number { font-size: 68px; }
  }

  @media (max-width: 760px) {
    .process-heading { grid-template-columns: 1fr; gap: 20px; margin-bottom: 30px; }
    .process-intro { max-width: 500px; }
    .process-steps { grid-template-columns: 1fr; gap: 0; }

    .process-card { position: relative; padding: 0 0 22px 57px; }

    .process-marker {
      position: absolute;
      left: 0;
      top: 20px;
      bottom: 0;
      margin: 0;
      display: block;
    }

    .process-number {
      width: 36px;
      height: 36px;
      font-size: 12px;
      box-shadow:
        0 0 0 4px color-mix(in srgb, var(--pr-blue) 14%, white),
        0 8px 16px color-mix(in srgb, var(--pr-blue) 30%, transparent);
    }

    .process-connector {
      position: absolute;
      left: 17px;
      top: 48px;
      bottom: -8px;
      width: 2px;
      border-radius: 2px;
      background: linear-gradient(180deg, color-mix(in srgb, var(--pr-blue) 50%, transparent), color-mix(in srgb, var(--pr-blue) 10%, transparent));
      font-size: 0;
    }

    .process-connector::before { display: none; }
    .process-card:last-child { padding-bottom: 0; }
    .process-card-body { padding: 24px 22px 0; border-radius: 18px; }
    .process-icon { width: 44px; height: 44px; margin-bottom: 20px; }
    .process-icon svg { width: 23px; height: 23px; }
    .process-card h3 { max-width: none; font-size: 23px; }
    .process-bg-number { font-size: 64px; }
    .process-ready { align-items: flex-start; margin-top: 24px; }
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .process-card-body {
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }
    .process-card-body:hover {
      transform: translateY(-6px);
      border-color: color-mix(in srgb, var(--pr-blue) 35%, transparent);
      box-shadow: 0 22px 44px color-mix(in srgb, var(--pr-blue) 16%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-number,
    .process-icon,
    .process-card-body::before { transition: none; }
  }
</style>
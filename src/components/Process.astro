---
const steps = [
  { title: 'Μας λέτε τι συμβαίνει.', text: 'Περιγράψτε τη συσκευή, το πρόβλημα και την περιοχή σας. Αυτά αρκούν για να ξεκινήσουμε.', note: 'Χρήσιμο: μάρκα & μοντέλο', icon: 'M7 9h10M7 13h6M5 3h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H9l-6 3V5a2 2 0 0 1 2-2Z', label: 'Η ΠΡΩΤΗ ΕΠΑΦΗ' },
  { title: 'Οργανώνουμε την επίσκεψη.', text: 'Συζητάμε τη διαθεσιμότητα, επιβεβαιώνουμε την περιοχή και σας ενημερώνουμε για τους όρους χρέωσης.', note: 'Πριν κλείσει το ραντεβού', icon: 'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2ZM8 15l3 3 5-5', label: 'ΤΟ ΡΑΝΤΕΒΟΥ' },
  { title: 'Ελέγχουμε τη συσκευή.', text: 'Με βάση τον έλεγχο, εξηγούμε την προτεινόμενη εργασία και αν χρειάζονται ανταλλακτικά.', note: 'Ξεκάθαρα επόμενα βήματα', icon: 'm9 12 2 2 4-4M12 3l8 4v5c0 5-8 9-8 9s-8-4-8-9V7l8-4Z', label: 'Ο ΤΕΧΝΙΚΟΣ ΕΛΕΓΧΟΣ' },
];
---
<section id="diadikasia" class="process-section" aria-labelledby="process-title">
  <div class="container section">
    <div class="process-heading" data-reveal>
      <div><p class="eyebrow">Η ΔΙΑΔΙΚΑΣΙΑ</p><h2 id="process-title">Εσείς μας λέτε την ανάγκη.<br /><span>Μαζί βρίσκουμε το επόμενο βήμα.</span></h2></div>
      <p class="process-intro">Τρία απλά βήματα, για να ξέρετε τι να περιμένετε από την πρώτη επικοινωνία μέχρι τον έλεγχο.</p>
    </div>
    <ol class="process-steps" role="list">
      {steps.map((step, index) => <li class="process-card" data-reveal style={`--reveal-delay: ${index * 85}ms`}>
        <div class="process-marker"><span class="process-number"><span class="sr-only">Βήμα </span>0{index + 1}</span><span class="process-connector" aria-hidden="true">→</span></div>
        <div class="process-card-body">
          <div class="process-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={step.icon} /></svg></div>
          <p class="process-label">{step.label}</p><h3>{step.title}</h3><p class="process-description">{step.text}</p>
          <p class="process-note"><span aria-hidden="true">✓</span>{step.note}</p>
        </div>
      </li>)}
    </ol>
    <div class="process-ready" data-reveal><span class="ready-symbol" aria-hidden="true">i</span><p><strong>Για μια πιο εύκολη πρώτη επικοινωνία</strong><br />Έχετε πρόχειρα το μοντέλο της συσκευής και μια σύντομη περιγραφή του προβλήματος.</p></div>
  </div>
</section>
<style>
  .process-section{background:linear-gradient(145deg,#f8fbff,#eaf2fc);border-block:1px solid #dce7f4}.process-heading{display:grid;grid-template-columns:1.5fr 1fr;gap:60px;align-items:end;margin-bottom:42px}.process-heading h2{font-size:clamp(29px,3vw,40px);line-height:1.2;margin:0}.process-heading h2 span{color:#537395}.process-intro{font-size:15px;margin:0;max-width:350px}.process-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;list-style:none;padding:0;margin:0}.process-card{min-width:0;display:flex;flex-direction:column}.process-marker{display:flex;align-items:center;gap:18px;margin-bottom:20px}.process-number{display:grid;place-items:center;width:44px;height:44px;flex:none;border-radius:50%;background:#1460dc;color:white;font-size:14px;font-weight:700;box-shadow:0 0 0 6px #dfeafa}.process-connector{display:flex;align-items:center;flex:1;gap:0;color:#779bbe;font-size:22px}.process-connector:before{content:'';height:1px;background:#bdd0e6;flex:1}.process-card:last-child .process-connector{visibility:hidden}.process-card-body{flex:1;display:flex;flex-direction:column;padding:30px 26px 0;border:1px solid #d4e1ef;border-radius:14px;background:#fff;box-shadow:0 7px 22px #173c6505}.process-icon{display:grid;place-items:center;width:48px;height:48px;background:#eef5ff;border:1px solid #e0ecfb;border-radius:12px;color:#1460dc;margin-bottom:28px}.process-icon svg{width:26px;height:26px}.process-label{font-size:10px;font-weight:700;letter-spacing:.13em;color:#657f99;margin-bottom:12px}.process-card h3{font-size:24px;line-height:1.2;max-width:250px;margin-bottom:16px}.process-description{font-size:15px;line-height:1.75;margin-bottom:26px}.process-note{display:flex;gap:9px;align-items:center;margin:auto 0 0;border-top:1px solid #e3ebf4;padding:17px 0;font-size:12px;color:#416180}.process-note span{color:#1460dc;font-weight:700}.process-ready{display:flex;align-items:center;gap:14px;margin-top:28px}.process-ready p{font-size:13px;margin:0;color:#5b728b}.process-ready strong{color:#294b6d;font-weight:600}.ready-symbol{display:grid;place-items:center;width:28px;height:28px;flex:none;border:1px solid #a9bfd7;border-radius:50%;color:#537395;font-family:Georgia,serif;font-style:italic}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:1000px){.process-heading{gap:30px;grid-template-columns:1.4fr 1fr}.process-steps{gap:16px}.process-card-body{padding:24px 20px 0}.process-card h3{font-size:21px}}
  @media(max-width:760px){.process-heading{grid-template-columns:1fr;gap:20px;margin-bottom:30px}.process-intro{max-width:500px}.process-steps{grid-template-columns:1fr;gap:0}.process-card{position:relative;padding:0 0 22px 57px}.process-marker{position:absolute;left:0;top:20px;bottom:0;margin:0;display:block}.process-number{width:34px;height:34px;font-size:12px;box-shadow:0 0 0 4px #dfeafa}.process-connector{position:absolute;left:16px;top:45px;bottom:-8px;width:1px;background:#bdd0e6;font-size:0}.process-connector:before{display:none}.process-card:last-child{padding-bottom:0}.process-card-body{padding:24px 22px 0}.process-icon{width:40px;height:40px;margin-bottom:20px}.process-icon svg{width:23px;height:23px}.process-card h3{max-width:none;font-size:23px}.process-ready{align-items:start;margin-top:24px}}
  @media(prefers-reduced-motion:no-preference) and (hover:hover){.process-card-body{transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}.process-card-body:hover{transform:translateY(-4px);border-color:#a5c4e8;box-shadow:0 12px 28px #173c650c}}
</style>

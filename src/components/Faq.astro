---
import { generalFaqs } from '../data/faqs.js';
import { withBase } from '../utils/urls.js';

const photo = withBase('images/Moutos/before-contact.png');
---

<section id="faq" class="section container faq-section">
  <div class="faq-side">
    <p class="eyebrow">ΣΥΧΝΕΣ ΕΡΩΤΗΣΕΙΣ · FAQ</p>
    <h2 class="faq-title">Πριν από το <span>ραντεβού.</span></h2>

    <div class="faq-visual">
      <div class="faq-blob" aria-hidden="true"></div>
      <img
        src={photo}
        alt="Πελάτισσα βλέπει το site και τηλεφωνεί για ραντεβού"
        loading="lazy"
        decoding="async"
      />
    </div>

    <a class="faq-link" href={withBase('faq/')}>
      Όλες οι ερωτήσεις ανά συσκευή
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          d="M5 12h14M13 6l6 6-6 6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>

  <div class="faq-list">
    {generalFaqs.slice(0, 5).map(([q, a]) => (
      <details class="faq-item">
        <summary>
          <span>{q}</span>
          <i class="faq-icon" aria-hidden="true"></i>
        </summary>
        <p>{a}</p>
      </details>
    ))}
  </div>
</section>

<style>
.faq-section {
  --f-accent: var(--blue, #0ea5e9);
  --f-accent-2: #22d3ee;
  --f-ink: var(--text, #0f172a);
  --f-muted: var(--muted, #526075);
  --f-border: rgba(15, 23, 42, 0.09);
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items: start;
}

  @media (min-width: 900px) {
    .faq-section {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .faq-side {
      position: sticky;
      top: 6rem;
    }
  }

  /* ---------- Left side ---------- */
  .faq-title {
    margin: 0 0 1.5rem;
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--f-ink);
  }

  .faq-title span {
    background: linear-gradient(90deg, var(--f-accent), var(--f-accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .faq-visual {
    position: relative;
    display: grid;
    place-items: end center;
    max-width: 380px;
    margin: 0 0 1.5rem;
    isolation: isolate;
  }

  .faq-blob {
    position: absolute;
    inset: 12% 4% 0;
    border-radius: 45% 55% 50% 50% / 50% 45% 55% 50%;
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--f-accent-2) 45%, white),
      color-mix(in srgb, var(--f-accent) 30%, white)
    );
    z-index: -1;
  }

  .faq-visual img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 18px 20px rgba(2, 6, 23, 0.22));
  }

  .faq-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--f-accent);
  }

  .faq-link svg {
    transition: transform 0.25s ease;
  }

  .faq-link:hover svg {
    transform: translateX(4px);
  }

  /* ---------- Accordion ---------- */
  .faq-list {
    display: grid;
    gap: 0.85rem;
  }

  .faq-item {
    border-radius: 16px;
    background: #fff;
    border: 1px solid var(--f-border);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    transition: box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .faq-item:hover {
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.09);
  }

  .faq-item[open] {
    border-color: color-mix(in srgb, var(--f-accent) 40%, transparent);
    box-shadow: 0 12px 30px color-mix(in srgb, var(--f-accent) 14%, transparent);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    line-height: 1.4;
    color: var(--f-ink);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:focus-visible {
    outline: 2px solid var(--f-accent);
    outline-offset: 2px;
    border-radius: 16px;
  }

  .faq-icon {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--f-accent) 12%, white);
    transition: transform 0.3s ease, background 0.3s ease;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 2px;
    border-radius: 2px;
    background: var(--f-accent);
    transform: translate(-50%, -50%);
    transition: background 0.3s ease;
  }

  .faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background: var(--f-accent);
  }

  .faq-item[open] .faq-icon::before,
  .faq-item[open] .faq-icon::after {
    background: #fff;
  }

  .faq-item p {
    margin: 0;
    padding: 0 1.3rem 1.25rem;
    line-height: 1.7;
    color: var(--f-muted);
    animation: faq-open 0.3s ease;
  }

  @keyframes faq-open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item p {
      animation: none;
    }
    .faq-icon,
    .faq-link svg {
      transition: none;
    }
  }
</style>
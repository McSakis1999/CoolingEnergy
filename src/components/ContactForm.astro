---
import { businessInfo } from '../data/businessInfo.js';
import { withBase } from '../utils/urls.js';
---
<section id="contact" class="section container contact-grid"><div><p class="eyebrow">ΕΠΙΚΟΙΝΩΝΙΑ</p><h2>Τι χρειάζεται<br />η συσκευή σας;</h2><p>Για να συζητήσουμε την εργασία, χρήσιμα είναι το μοντέλο της συσκευής, μια σύντομη περιγραφή και η περιοχή σας.</p>
{businessInfo.phone && <p><a class="text-link" href={'tel:'+businessInfo.phone}>{businessInfo.phoneFormatted || businessInfo.phone}</a></p>}
{businessInfo.email && <p><a class="text-link" href={'mailto:'+businessInfo.email}>{businessInfo.email}</a></p>}
{businessInfo.viberUrl && <p><a class="text-link" href={businessInfo.viberUrl}>Στείλτε μήνυμα στο Viber</a></p>}
{!businessInfo.phone && !businessInfo.email && <p class="notice">Τα στοιχεία επικοινωνίας θα προστεθούν σύντομα. Προς το παρόν δεν είναι διαθέσιμη η κράτηση ραντεβού.</p>}
</div><div class="contact-panel">
  <h3>Αίτημα επικοινωνίας</h3>
  <p>Στείλτε μας τα στοιχεία σας και μια σύντομη περιγραφή της ανάγκης σας.</p>
  <form action={'https://formsubmit.co/'+businessInfo.email} method="POST">
    <input type="hidden" name="_subject" value="Νέο αίτημα επικοινωνίας — CoolingEnergy" />
    <input type="hidden" name="_template" value="table" />
    <input type="text" name="_honey" hidden tabindex="-1" autocomplete="off" aria-hidden="true" />
    <label>Ονοματεπώνυμο<input type="text" name="name" autocomplete="name" maxlength="120" required /></label>
    <label>Τηλέφωνο<input type="tel" name="phone" autocomplete="tel" maxlength="40" required /></label>
    <label>Email (προαιρετικό)<input type="email" name="email" autocomplete="email" maxlength="254" /></label>
    <label>Πώς μπορούμε να βοηθήσουμε;<textarea name="message" rows="4" maxlength="5000" required></textarea></label>
    <p class="form-privacy">Τα στοιχεία σας χρησιμοποιούνται για την απάντηση στο αίτημά σας. Η αποστολή γίνεται μέσω FormSubmit με έλεγχο προστασίας από ανεπιθύμητα μηνύματα (Google reCAPTCHA). <a href={withBase('privacy/')}>Απόρρητο & cookies</a>.</p>
    <button type="submit" class="button">Αποστολή μηνύματος <span aria-hidden="true">↗</span></button>
  </form>
</div></section>
<style>
.form-privacy{font-size:13px;line-height:1.6;color:#416180}.form-privacy a{text-decoration:underline}.contact-panel button{width:100%}
</style>
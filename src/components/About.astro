---
// Adjust if your image lives elsewhere (files in /public are served from the root)
const photo = "/images/Moutos/transparent-work.png";

const services = [
  "Κλιματιστικά",
  "Ψυγεία",
  "Πλυντήρια ρούχων",
  "Ηλεκτρικές κουζίνες",
];
---

<section id="about" class="section container about">
  <div class="about-grid-modern">
    <!-- Visual -->
    <div class="about-visual">
      <div class="about-glow" aria-hidden="true"></div>
      <div class="about-ring" aria-hidden="true"></div>

      <figure class="about-figure">
        <img
          src={photo}
          alt="Ο Γιώργος Μούτος εργάζεται σε κλιματιστική μονάδα"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="about-badge about-badge--top">
        <span class="badge-dot"></span>
        Βόλος &amp; Πήλιο
      </div>
      <div class="about-badge about-badge--bottom">
        <strong>Εγκατάσταση</strong>
        <span>Καθαρισμός · Επισκευή</span>
      </div>
    </div>

    <!-- Content -->
    <div class="about-content">
      <p class="eyebrow">Ο ΑΝΘΡΩΠΟΣ ΠΙΣΩ ΑΠΟ ΤΗΝ COOLINGENERGY</p>
      <h2 class="about-title">Γιώργος <span>Μούτος</span></h2>

      <p class="about-lead">
        Τεχνική φροντίδα για κλιματιστικά, ψυγεία, πλυντήρια ρούχων και
        ηλεκτρικές κουζίνες στον Βόλο και το Πήλιο.
      </p>

      <p class="about-text">
        Από την εγκατάσταση μιας νέας συσκευής μέχρι τον καθαρισμό και την
        επισκευή, η αφετηρία είναι η ανάγκη του δικού σας σπιτιού. Περιγράψτε τη
        συσκευή, το πρόβλημα και την περιοχή σας για να συζητηθεί η κατάλληλη
        εργασία.
      </p>

      <ul class="about-chips">
        {services.map((s) => <li>{s}</li>)}
      </ul>

      <a href="#contact" class="about-cta">
        Περιγράψτε το πρόβλημά σας
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M5 12h14M13 6l6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
.about {
  --a-accent: var(--blue, #0ea5e9);
  --a-accent-2: #22d3ee;
  --a-ink: var(--text, #0f172a);
  --a-muted: var(--muted, #526075);
  --a-card: rgba(255, 255, 255, 0.72);
  --a-border: rgba(15, 23, 42, 0.08);
  position: relative;
}

  .about-grid-modern {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .about-grid-modern {
      grid-template-columns: 1.05fr 1fr;
    }
  }

  /* ---------- Visual ---------- */
  .about-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 380px;
    isolation: isolate;
  }

  .about-glow {
    position: absolute;
    inset: 8% 6% 4%;
    border-radius: 42% 58% 55% 45% / 48% 42% 58% 52%;
    background:
      radial-gradient(circle at 30% 25%, var(--a-accent-2), transparent 60%),
      linear-gradient(145deg, var(--a-accent), #1e3a8a);
    opacity: 0.9;
    filter: saturate(1.1);
    animation: morph 14s ease-in-out infinite alternate;
    z-index: -2;
  }

  .about-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px dashed color-mix(in srgb, var(--a-accent) 45%, transparent);
    transform: scale(0.98);
    animation: spin 40s linear infinite;
    z-index: -1;
  }

  .about-figure {
    margin: 0;
    width: 100%;
    display: grid;
    place-items: end center;
  }

  .about-figure img {
    display: block;
    width: 100%;
    max-width: 520px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 30px 30px rgba(2, 6, 23, 0.35));
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .about-visual:hover .about-figure img {
    transform: translateY(-6px) scale(1.02);
  }

  .about-badge {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    background: var(--a-card);
    border: 1px solid var(--a-border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.14);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--a-ink);
    animation: float 6s ease-in-out infinite;
  }

  .about-badge--top {
    top: 6%;
    left: 2%;
  }

  .about-badge--bottom {
    bottom: 8%;
    right: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    border-radius: 18px;
    animation-delay: -3s;
  }

  .about-badge--bottom strong {
    font-size: 0.95rem;
  }

  .about-badge--bottom span {
    font-weight: 500;
    color: var(--a-muted);
    font-size: 0.78rem;
  }

  .badge-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6);
    animation: pulse 2s infinite;
  }

  /* ---------- Content ---------- */
  .about-title {
    margin: 0 0 1.25rem;
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--a-ink);
  }

  .about-title span {
    background: linear-gradient(90deg, var(--a-accent), var(--a-accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .about-lead {
    margin: 0 0 1rem;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.5;
    font-weight: 500;
    color: var(--a-ink);
  }

  .about-text {
    margin: 0 0 1.75rem;
    line-height: 1.75;
    color: var(--a-muted);
    max-width: 58ch;
  }

  .about-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
    margin: 0 0 2rem;
  }

  .about-chips li {
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--a-ink);
    background: color-mix(in srgb, var(--a-accent) 10%, white);
    border: 1px solid color-mix(in srgb, var(--a-accent) 25%, transparent);
    transition: transform 0.25s ease, background 0.25s ease;
  }

  .about-chips li:hover {
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--a-accent) 18%, white);
  }

  .about-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 1.5rem;
    border-radius: 14px;
    font-weight: 700;
    text-decoration: none;
    color: #fff;
    background: linear-gradient(135deg, var(--a-accent), #2563eb);
    box-shadow: 0 14px 28px color-mix(in srgb, var(--a-accent) 40%, transparent);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .about-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 34px color-mix(in srgb, var(--a-accent) 50%, transparent);
  }

  .about-cta svg {
    transition: transform 0.25s ease;
  }

  .about-cta:hover svg {
    transform: translateX(4px);
  }

  /* ---------- Animations ---------- */
  @keyframes morph {
    to {
      border-radius: 58% 42% 45% 55% / 42% 55% 45% 58%;
      transform: rotate(6deg) scale(1.03);
    }
  }
  @keyframes spin {
    to {
      transform: rotate(360deg) scale(0.98);
    }
  }
  @keyframes float {
    50% {
      transform: translateY(-10px);
    }
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 10px rgba(34, 197, 94, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-glow,
    .about-ring,
    .about-badge,
    .badge-dot {
      animation: none;
    }
  }

  @media (max-width: 520px) {
    .about-badge--top {
      left: 0;
    }
    .about-visual {
      min-height: 320px;
    }
  }
</style>
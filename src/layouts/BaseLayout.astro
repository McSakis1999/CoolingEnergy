---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { withBase, absoluteUrl } from '../utils/urls.js';
import { socialCardForPath } from '../data/social.js';
const { title = 'Ψυκτικός Βόλος & Πήλιο | Ψυγεία, Πλυντήρια, Κουζίνες | CoolingEnergy', description = 'Κλιματιστικά, επισκευή ψυγείων, πλυντηρίων και ηλεκτρικών κουζινών. CoolingEnergy — Γιώργος Μούτος, Βόλος και Πήλιο.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const card = socialCardForPath(Astro.url.pathname, import.meta.env.BASE_URL);
const socialImage = absoluteUrl(`social/${card.id}.png`);
const socialAlt = `CoolingEnergy — ${card.title || card.lines.join(' ')} — Βόλος & Πήλιο`;
---
<!doctype html>
<html lang="el">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title><meta name="description" content={description} />
<link rel="canonical" href={canonical} /><link rel="icon" href={withBase('images/logo.png')} />
<meta property="og:type" content="website" /><meta property="og:locale" content="el_GR" />
<meta property="og:title" content={title} /><meta property="og:description" content={description} />
<meta property="og:url" content={canonical} /><meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" /><meta property="og:image:alt" content={socialAlt} />
<meta property="og:site_name" content="CoolingEnergy" /><meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} /><meta name="twitter:image:alt" content={socialAlt} />
<slot name="schema" />
<script src="../scripts/motion.js"></script>
</head>
<body><a class="skip-link" href="#main">Μετάβαση στο περιεχόμενο</a><Header /><main id="main"><slot /></main><Footer /><CookieConsent /></body>
</html>

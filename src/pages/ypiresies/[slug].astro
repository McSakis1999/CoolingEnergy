---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import FeaturedJobs from '../../components/FeaturedJobs.astro';
import { servicesData } from '../../data/services.js';
import { withBase, serviceUrl, absoluteUrl } from '../../utils/urls.js';
import { generateHvacSchema } from '../../utils/schema.js';
export function getStaticPaths() { return servicesData.map(service=>({params:{slug:service.slug},props:{service}})); }
const { service } = Astro.props;
const sameGroup = servicesData.filter(s=>s.group===service.group && s.slug!==service.slug);
const related = sameGroup.length ? sameGroup : servicesData.filter(s=>s.slug!==service.slug && s.slug.startsWith('episkevi'));
const schema = { '@context':'https://schema.org', '@type':'Service', name:service.title, description:service.description, url:absoluteUrl('ypiresies/'+service.slug+'/'), provider:generateHvacSchema() };
---
<BaseLayout title={service.title+' στον Βόλο & το Πήλιο | CoolingEnergy'} description={service.description+' CoolingEnergy — Βόλος και Πήλιο.'}>
<script type="application/ld+json" slot="schema" set:html={JSON.stringify(schema)} />
<section class="service-hero"><div class="container"><nav class="breadcrumbs" aria-label="Διαδρομή"><a href={withBase()}>Αρχική</a><span>/</span><a href={withBase('#services')}>Υπηρεσίες</a></nav><p class="eyebrow">{{ac:'ΚΛΙΜΑΤΙΣΤΙΚΑ',washer:'ΠΛΥΝΤΗΡΙΑ ΡΟΥΧΩΝ',fridge:'ΨΥΓΕΙΑ',kitchen:'ΗΛΕΚΤΡΙΚΕΣ ΚΟΥΖΙΝΕΣ'}[service.group]} · ΒΟΛΟΣ & ΠΗΛΙΟ</p><h1>{service.title}</h1><p class="hero-copy">{service.intro}</p><a class="button" href="#contact">Επικοινωνία για την υπηρεσία ↗</a></div></section>
<div class="container section detail-grid"><article><section><h2>Πότε να ζητήσετε έλεγχο</h2><ul class="check-list">{service.symptoms.map(s=><li>{s}</li>)}</ul></section><section><h2>Τι μπορεί να περιλαμβάνει</h2><p>Οι παρακάτω εργασίες είναι ενδεικτικές. Το ακριβές αντικείμενο επιβεβαιώνεται ανάλογα με τη συσκευή και τον έλεγχο.</p><ul class="check-list">{service.scope.map(s=><li>{s}</li>)}</ul></section><section><h2>Πριν από την επίσκεψη</h2><p>{service.preparation}</p></section><section><h2>Τι επηρεάζει το κόστος</h2><p>{service.pricing}</p><p>Διευκρινίστε τη χρέωση επίσκεψης ή διάγνωσης, μετακίνησης και τυχόν πρόσθετων εργασιών πριν από το ραντεβού.</p></section><section><h2>Συχνές ερωτήσεις</h2>{service.faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section></article><aside class="related-panel"><p class="eyebrow">ΔΕΙΤΕ ΕΠΙΣΗΣ</p><h3>Σχετικές υπηρεσίες</h3>{related.map(s=><a href={serviceUrl(s.slug)}>{s.title}<span aria-hidden="true">↗</span></a>)}<a href={withBase("perioxes/")}>Περιοχές στο Πήλιο ↗</a><a href={withBase("faq/")}>Όλες οι συχνές ερωτήσεις ↗</a><p>Βόλος & Πήλιο<br /><small>Η κάλυψη της περιοχής σας επιβεβαιώνεται πριν από την επίσκεψη.</small></p></aside></div><FeaturedJobs category={service.group} /><ContactForm />
</BaseLayout>


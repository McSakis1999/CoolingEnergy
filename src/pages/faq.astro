---
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqGroups } from '../data/faqs.js';
import { withBase } from '../utils/urls.js';
---
<BaseLayout title="Συχνές ερωτήσεις (FAQ) για συσκευές & ψυκτικό στο Πήλιο | CoolingEnergy" description="Απαντήσεις για ψυγεία, πλυντήρια, ηλεκτρικές κουζίνες και κλιματιστικά. Βλάβες, συντήρηση, κόστος και επίσκεψη τεχνικού στον Βόλο και το Πήλιο.">
<section class="service-hero"><div class="container"><nav class="breadcrumbs" aria-label="Διαδρομή"><a href={withBase()}>Αρχική</a><span>/</span><span>FAQ</span></nav><p class="eyebrow">ΣΥΧΝΕΣ ΕΡΩΤΗΣΕΙΣ · FAQ</p><h1>Μια πρώτη απάντηση.<br />Πριν από τον τεχνικό.</h1><p class="hero-copy">Για τις συσκευές του σπιτιού σας και την επίσκεψη στον Βόλο ή το Πήλιο. Οι απαντήσεις βοηθούν στην προετοιμασία· η αιτία μιας βλάβης καθορίζεται με έλεγχο.</p><nav class="topic-links" aria-label="Κατηγορίες ερωτήσεων">{faqGroups.map(g=><a href={'#'+g.id}>{g.title}</a>)}</nav></div></section>
<div class="container section faq-directory">{faqGroups.map(group=><section id={group.id}><h2>{group.title}</h2>{group.faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>)}<div class="actions"><a class="button" href={withBase('#contact')}>Επικοινωνία για τη συσκευή σας ↗</a><a class="text-link" href={withBase('perioxes/')}>Δείτε τις περιοχές</a></div></div>
</BaseLayout>

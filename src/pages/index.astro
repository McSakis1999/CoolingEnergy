---
import BaseLayout from '../layouts/BaseLayout.astro';
import Brands from '../components/Brands.astro';
import Process from '../components/Process.astro';
import Gallery from '../components/Gallery.astro';
import Faq from '../components/Faq.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import ContactForm from '../components/ContactForm.astro';
import CommonProblems from '../components/CommonProblems.astro';
import { generateHvacSchema } from '../utils/schema.js';
---
<BaseLayout><script type="application/ld+json" slot="schema" set:html={JSON.stringify(generateHvacSchema())} />
<Hero /><Brands /><Services />
<CommonProblems />
<Process />
<About /><Gallery /><ServiceAreas />
<Faq />
<ContactForm /></BaseLayout>

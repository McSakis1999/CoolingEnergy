---
import PeopleLayout from '../layouts/PeopleLayout.astro';
import { jobs } from '../data/jobs.js';
import { publishedJobs } from '../utils/jobs.js';
import JobCard from '../components/JobCard.astro';
const projects = publishedJobs(jobs);
import { withBase } from '../utils/urls.js';
---
<PeopleLayout title="Από τη δουλειά μας — Έργα & φωτογραφίες" description="Φωτογραφίες και παρουσιάσεις εργασιών της CoolingEnergy σε κλιματιστικά και οικιακές συσκευές." eyebrow="ΕΙΚΟΝΕΣ & ΛΕΠΤΟΜΕΡΕΙΕΣ ΑΠΟ ΤΙΣ ΕΡΓΑΣΙΕΣ" heading="Από τη δουλειά μας." intro="Μια ματιά στις συσκευές, τις ανάγκες και τις εργασίες που αναλαμβάνουμε.">
{projects.length ? <div class="project-list">{projects.map(job => <JobCard job={job} detailed />)}</div> : <><h2>Οι πρώτες παρουσιάσεις ετοιμάζονται.</h2><p>Σύντομα θα προστεθούν πραγματικές φωτογραφίες έργων, μαζί με πληροφορίες για τη συσκευή, την ανάγκη και την εργασία που πραγματοποιήθηκε.</p><div class="gallery-grid">{['Κλιματισμός','Πλυντήρια & ψυγεία','Κουζίνες & φούρνοι'].map(title=><figure><div class="photo-placeholder"><span aria-hidden="true">＋</span><p>Φωτογραφίες έργων σύντομα</p></div><figcaption><h3>{title}</h3><p>Εδώ θα παρουσιαστούν εργασίες με φωτογραφίες και σύντομη περιγραφή.</p></figcaption></figure>)}</div></>}
<div class="actions"><a class="button" href={withBase('#services')}>Δείτε τις υπηρεσίες μας →</a><a class="text-link" href={withBase('#contact')}>Επικοινωνία ↗</a></div>
</PeopleLayout>
<style>.project-list{display:grid;gap:56px}.project-list article{padding-bottom:40px;border-bottom:1px solid #dce5ef}</style>

